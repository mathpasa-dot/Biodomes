# Copier ce fichier en .env sur le serveur puis adapter les valeurs.
# Utiliser des guillemets simples si une valeur contient un "$".

# Nom de domaine (ou sous-domaine) dont l'enregistrement DNS A pointe vers l'IP du serveur.
# Exemple Azure gratuit : biodomes-xxx.westeurope.cloudapp.azure.com
DOMAIN=localhost

# Image publiée par GitHub Actions (laisser vide pour builder sur le serveur)
# BIODOMES_IMAGE=ghcr.io/<ton-user-github>/biodomes:latest

# Comptes de démonstration créés au démarrage
SEED_DEMO_USERS=true
# Admin (alice@company.com) : garder ce mot de passe privé
ADMIN_PASSWORD='ChangeMe-Admin1!'
# Employés (bob@company.com, celia@company.com) : peut être affiché publiquement pour la démo
DEMO_PASSWORD='Demo1234!'

# Envoi d'emails (confirmation d'inscription).
# Sans SMTP, l'inscription est confirmée directement (pratique pour une démo).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
