<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - BioDomes.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/BioDomes.Web.styles.css" asp-append-version="true"/>
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
<header class="py-3 border-bottom mb-4">
    <div class="container text-center">
        <a asp-page="/Index" class="d-inline-flex align-items-center gap-2 text-decoration-none text-dark">
            <img src="@Url.Content("~/images/build-in/BioDome.png")"
                 alt="BioDomes logo"
                 style="width: 40px; height: 40px; object-fit: cover; border-radius: 50%;"/>
            <span class="fs-4 fw-semibold">BioDomes : Terrarium Zero</span>
        </a>
    </div>
</header>

<div class="container flex-grow-1">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-auto">
    <div class="container">
        &copy; 2025 - BioDomes.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", false)
</body>
</html>