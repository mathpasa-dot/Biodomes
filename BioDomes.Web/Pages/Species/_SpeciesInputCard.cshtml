@using BioDomes.Domains.SpeciesDom
@model CommonForm

@{
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
    var headerClass = isEdit ? "bg-warning text-dark" : "bg-success text-white";
    var title = isEdit ? "Éditer une espèce" : "Ajouter une espèce";
    var submitLabel = isEdit ? "Sauvegarder" : "Ajouter";
    var submitClass = isEdit ? "btn-warning" : "btn-success";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">

                <div class="card-header @headerClass">
                    <h4 class="mb-0">@title</h4>
                </div>

                <div class="card-body">

                    <form method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" autofocus/>
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.SpeciesType" class="form-label"></label>
                            <select asp-for="Input.SpeciesType" class="form-select">
                                @foreach (var type in Model.SpeciesTypes)
                                {
                                    <option value="@type">@type.ToDisplayString()</option>
                                }
                            </select>
                            <span asp-validation-for="Input.SpeciesType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.SpeciesRegime" class="form-label"></label>
                            <select asp-for="Input.SpeciesRegime" class="form-select">
                                @foreach (var regime in Model.Regimes)
                                {
                                    <option value="@regime">@regime.ToDisplayString()</option>
                                }
                            </select>
                            <span asp-validation-for="Input.SpeciesRegime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Height" class="form-label"></label>
                            <input asp-for="Input.Height" class="form-control" step="1"/>
                            <span asp-validation-for="Input.Height" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Weight" class="form-label"></label>
                            <input asp-for="Input.Weight" class="form-control" step="0.01" placeholder="Ex: 12,3"/>
                            <span asp-validation-for="Input.Weight" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ImageFile" class="form-label"></label>

                            @if (isEdit && Model.Input.ExistingImagePath != null)
                            {
                                <div class="mb-2">
                                    <img src="@Url.Content("~" + Model.Input.ExistingImagePath)" alt="Current image"
                                         style="max-height: 150px; object-fit: cover;" class="img-thumbnail" loading="lazy"/>
                                    <p class="text-muted small mt-1">Image actuellement utilisée</p>
                                </div>
                            }

                            <input asp-for="Input.ImageFile" class="form-control" type="file" accept="image/*"/>
                            <input type="hidden" asp-for="Input.ExistingImagePath"/>
                            <span asp-validation-for="Input.ImageFile" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/Species/Index" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn @submitClass">@submitLabel</button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}