@page
@model BiomeModel

@section Styles {
    <link rel="stylesheet" href="~/css/explore.css" />
}

<div class="text-center mb-4">
    <h1 class="display-4">Biomes</h1>
    @if (User.IsInRole("Admin"))
    {
        <span class="badge bg-danger ms-2">Vue admin — Tous les biomes</span>
    }
</div>

<!-- Carrousel -->
<div class="biome-carousel">
    
    <div class="biome-carousel-header">
        <a asp-page="./AddBiome" class="btn btn-success px-4">
            + Ajouter un biome
        </a>
    </div>
    
    @if (!Model.Biomes.Any())
    {
        <div class="alert alert-info mt-3">
            Aucun biome disponible.
        </div>
    }
    else
    {
    <div class="biome-carousel-track-outer">
        <div class="biome-carousel-track" id="biomeTrack">
            @foreach (var biome in Model.Biomes)
            {
                <div class="biome-carousel-slide">
                    <partial name="_BiomeCard" model="biome"/>
                </div>
            }
        </div>
    </div>

    <div class="biome-carousel-nav">
        <div class="biome-carousel-arrows">
            <button class="biome-carousel-btn" id="biomePrev" disabled>&#8592;</button>
            <button class="biome-carousel-btn" id="biomeNext">&#8594;</button>
        </div>
        <div class="biome-carousel-dots" id="biomeDots"></div>
    </div>
    }
</div>


@section Scripts {
    <script>
        (function () {
            const PER_PAGE = 3;
            const track = document.getElementById('biomeTrack');
            const dotsEl = document.getElementById('biomeDots');
            const prevBtn = document.getElementById('biomePrev');
            const nextBtn = document.getElementById('biomeNext');

            if (!track) return;

            const slides = track.querySelectorAll('.biome-carousel-slide');
            const total = slides.length;
            const pageCount = Math.ceil(total / PER_PAGE);
            let page = 0;

            // Créer les points
            for (let i = 0; i < pageCount; i++) {
                const d = document.createElement('div');
                d.className = 'biome-dot' + (i === 0 ? ' active' : '');
                dotsEl.appendChild(d);
            }

            function go(n) {
                page = Math.max(0, Math.min(pageCount - 1, n));
                const slideW = slides[0].offsetWidth + 16; // gap = 16px
                track.style.transform = `translateX(-${page * PER_PAGE * slideW}px)`;
                dotsEl.querySelectorAll('.biome-dot').forEach((d, i) =>
                    d.classList.toggle('active', i === page)
                );
                prevBtn.disabled = page === 0;
                nextBtn.disabled = page === pageCount - 1;
            }

            prevBtn.addEventListener('click', () => go(page - 1));
            nextBtn.addEventListener('click', () => go(page + 1));

            // Recalcul si redimensionnement
            window.addEventListener('resize', () => go(page));
        })();
    </script>
}