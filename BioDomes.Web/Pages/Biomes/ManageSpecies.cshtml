@page "/ManageSpecies/{slug:kebab}"
@using BioDomes.Domains
@using BioDomes.Domains.SpeciesDom
@model ManageSpecies

@section Styles {
    <style>
        p {
            background: none;
            border: none;
        }
    </style>
}

<h1 class="display-5 text-center mb-4">Espèces - @Model.Biome.Name</h1>

<div class="d-flex justify-content-center align-items-center gap-2 mb-3">
    <a asp-page="./Index" class="btn btn-sm btn-secondary">← Liste biomes</a>
    <a asp-page="./Dashboard" asp-route-slug="@Model.Slug" class="btn btn-sm btn-primary">Dashboard</a>
    <a asp-page="./EditChain" asp-route-slug="@Model.Slug" class="btn btn-sm btn-secondary">Prédations</a>
</div>

@if (Model.HungryWarnings.Any())
{
    <div class="row g-3 mb-4 mx-auto" style="max-width: 720px;">

        <!-- PROBLÈMES -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-header bg-warning bg-opacity-25">
                    <strong>⚠️ Problèmes détectés</strong>
                </div>

                <div class="card-body p-2" style="max-height: 180px; overflow-y: auto;">
                    <ul class="mb-0 ps-3 small">
                        @foreach (var c in Model.HungryWarnings)
                        {
                            <li class="text-warning">@c.Warning</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- SUGGESTIONS -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm border-info h-100">
                <div class="card-header bg-info bg-opacity-25">
                    <strong>💡 Suggestions</strong>
                </div>

                <div class="card-body p-2" style="max-height: 180px; overflow-y: auto;">
                    @if (Model.Suggestions.Any())
                    {
                        <ul class="mb-0 ps-3 small">
                            @foreach (var s in Model.Suggestions)
                            {
                                <li class="text-info">@s</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted small">Aucune suggestion disponible</span>
                    }
                </div>
            </div>
        </div>

    </div>
}
else
{
    <div class="alert alert-success text-center mb-4">
        <strong>✓ Biome équilibré</strong>
    </div>
}

<div class="mx-auto" style="max-width: 720px;">
    <div class="d-flex justify-content-end mb-2">
        <button type="button"
                class="btn btn-success px-4"
                data-bs-toggle="modal"
                data-bs-target="#modalAddSpecies">
            + Ajouter une espèce
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form method="post" asp-page-handler="UpdateSpeciesQuantities">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0" style="table-layout: fixed;">
                    <thead class="table-light">
                    <tr>
                        <th>Espèce</th>
                        <th style="width: 120px;">Masse</th>
                        <th style="width: 110px;">Quantité</th>
                        <th style="width: 110px;"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var species in Model.Biome.Population)
                    {
                        <tr>
                            <td class="align-middle">@species.Key.Name</td>
                            <td class="align-middle">@species.Key.Weight kg</td>
                            <td>
                                <input type="number"
                                       name="quantities[@species.Key.Name]"
                                       value="@species.Value"
                                       min="1"
                                       class="form-control form-control-sm"/>
                            </td>
                            <td class="align-middle text-end">
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDeleteSpecies"
                                        data-species-name="@species.Key.Name"
                                        data-species-kebab="@species.Key.Name.ToKebabCase()">
                                    Supprimer
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted small">@Model.Biome.Population.Count espèce@(Model.Biome.Population.Count > 1 ? "s" : "")</span>
                <button type="submit" class="btn btn-sm btn-primary">Sauvegarder les quantités</button>
            </div>
        </div>
    </form>
</div>    

@* Formulaires de suppression hors du tableau *@
@foreach (var species in Model.Biome.Population)
{
    <form id="delete-species-@species.Key.Name.ToKebabCase()"
          method="post"
          asp-page-handler="DeleteSpecies">
        <input type="hidden" name="speciesName" value="@species.Key.Name"/>
    </form>
}

@* Modale — ajouter une espèce *@
<div class="modal fade" id="modalAddSpecies" tabindex="-1" aria-labelledby="modalAddSpeciesLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalAddSpeciesLabel">Ajouter une espèce</h5>
            </div>
            <form method="post" asp-page-handler="AddSpecies">
                <div class="modal-body d-flex flex-column gap-3">
                    <div class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label class="form-label">Espèce</label>
                            <select name="speciesName" class="form-select">
                                @foreach (var s in Model.AvailableSpeciesToAdd)
                                {
                                    <option value="@s.Name">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Quantité</label>
                            <input type="number" name="quantity" value="1" min="1"
                                   class="form-control" style="width: 80px;"/>
                        </div>
                    </div>
                    <hr class="my-0"/>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">Prédateurs (du biome)</label>
                            <select name="predators" class="form-select" multiple size="5">
                                @foreach (var s in Model.Biome.Population.Keys)
                                {
                                    <option value="@s.Name">@s.Name</option>
                                }
                            </select>
                            <small class="text-muted">Ctrl/Cmd pour sélection multiple</small>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Proies (du biome)</label>
                            <select name="prey" class="form-select" multiple size="5">
                                @foreach (var s in Model.Biome.Population.Keys)
                                {
                                    <option value="@s.Name">@s.Name</option>
                                }
                            </select>
                            <small class="text-muted">Ctrl/Cmd pour sélection multiple</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success">Ajouter</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modale — confirmer la suppression *@
<div class="modal fade" id="modalDeleteSpecies" tabindex="-1" aria-labelledby="modalDeleteSpeciesLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDeleteSpeciesLabel">Supprimer cette espèce ?</h5>
            </div>
            <div class="modal-body">
                <p class="mb-1">
                    Supprimer <strong id="deleteSpeciesName"></strong> du biome ?
                </p>
                <p class="text-muted small mb-0">
                    Les liens de prédation associés seront également supprimés.
                    L'espèce reste disponible dans le catalogue.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit"
                        id="deleteSpeciesSubmit"
                        class="btn btn-danger">
                    Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Injecte le nom de l'espèce dans la modale de suppression
        // et soumet le bon formulaire hidden
        const deleteModal = document.getElementById('modalDeleteSpecies');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            const name = btn.getAttribute('data-species-name');
            const kebab = btn.getAttribute('data-species-kebab');

            document.getElementById('deleteSpeciesName').textContent = name;
            document.getElementById('deleteSpeciesSubmit').setAttribute('form', 'delete-species-' + kebab);
        });
    </script>
}