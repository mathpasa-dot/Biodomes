@model CommonForm
@{
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
    var headerClass = isEdit ? "bg-warning text-dark" : "bg-success text-white";
    var title = isEdit ? "Éditer un équipement" : "Ajouter un équipement";
    var submitLabel = isEdit ? "Sauvegarder" : "Ajouter";
    var submitClass = isEdit ? "btn-warning" : "btn-success";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">

                <div class="card-header @headerClass">
                    <h4 class="mb-0">@title</h4>
                </div>

                <div class="card-body">

                    <form method="post" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" autofocus/>
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label asp-for="Input.Consumed" class="form-label"></label>
                                <select asp-for="Input.Consumed" class="form-select" multiple size="5">
                                    @foreach (var ingredient in Model.Ingredients)
                                    {
                                        <option value="@ingredient.Name">@ingredient.Name</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Ctrl/Cmd pour sélection multiple</small>
                            </div>

                            <div class="mb-3 col-md-6">
                                <label asp-for="Input.Produced" class="form-label"></label>
                                <select asp-for="Input.Produced" class="form-select" multiple size="5">
                                    @foreach (var ingredient in Model.Ingredients)
                                    {
                                        <option value="@ingredient.Name">@ingredient.Name</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Ctrl/Cmd pour sélection multiple</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ImageFile" class="form-label"></label>

                            @if (isEdit && Model.Input.ExistingImagePath != null)
                            {
                                <div class="mb-2">
                                    <img src="@Url.Content("~" + Model.Input.ExistingImagePath)" alt="Current image"
                                         style="max-height: 150px; object-fit: cover;" class="img-thumbnail" loading="lazy"/>
                                    <p class="text-muted small mt-1">Image actuellement utilisée</p>
                                </div>
                            }

                            <input asp-for="Input.ImageFile" class="form-control" type="file" accept="image/*"/>
                            <input type="hidden" asp-for="Input.ExistingImagePath"/>
                            <span asp-validation-for="Input.ImageFile" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-page="/Equipments/Index" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn @submitClass">@submitLabel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>